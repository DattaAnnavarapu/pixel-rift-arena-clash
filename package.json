{
  "name": "pixel-rift",
  "version": "1.2.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/start.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "release:check": "npm test && npm run build && node --import tsx scripts/production-smoke.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.1.0"
  }
}
